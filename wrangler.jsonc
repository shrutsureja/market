{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fpi-market",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "routes": [
    { "pattern": "fpi.shrutsureja.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fpi-market",
      "database_id": "8fca2f4d-faa0-4b7c-b2b0-6fd4213ab9af",
      "migrations_dir": "migrations"
    }
  ]
}
